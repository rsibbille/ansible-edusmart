---
name: edusmart-monitoring

services:
  prometheus:
    image: quay.io/prometheus/prometheus:{{ prometheus_version }}
    container_name: prometheus
    restart: "{{ docker_container_restart_policy }}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention_time }}
      - --web.enable-lifecycle
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus
    ports:
      - "{{ monitoring_bind_ip }}:9090:9090"
    networks:
      - monitoring
      - edusmart_proxy
    security_opt:
      - no-new-privileges:true
    depends_on:
      - alertmanager
      - node-exporter
      - cadvisor
  grafana-db:
    image: postgres:{{ grafana_postgres_version }}
    container_name: grafana-postgres
    restart: "{{ docker_container_restart_policy }}"
    environment:
      POSTGRES_DB: grafana
      POSTGRES_USER: grafana
      POSTGRES_PASSWORD: ${GRAFANA_DB_PASSWORD}
    volumes:
      - grafana_postgres_data:/var/lib/postgresql
    networks:
      - monitoring
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U grafana -d grafana
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    security_opt:
      - no-new-privileges:true

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    restart: "{{ docker_container_restart_policy }}"
    environment:
      GF_SECURITY_ADMIN_USER: eds_admin
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"

      GF_DATABASE_TYPE: postgres
      GF_DATABASE_HOST: grafana-db:5432
      GF_DATABASE_NAME: grafana
      GF_DATABASE_USER: grafana
      GF_DATABASE_PASSWORD: ${GRAFANA_DB_PASSWORD}
      GF_DATABASE_SSL_MODE: disable

      GF_PLUGINS_PREINSTALL_AUTO_UPDATE: "false"

    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro

    ports:
      - "{{ monitoring_bind_ip }}:3000:3000"

    networks:
      - monitoring
      - edusmart_proxy

    security_opt:
      - no-new-privileges:true

    depends_on:
      prometheus:
        condition: service_started
      grafana-db:
        condition: service_healthy

  alertmanager:
    image: quay.io/prometheus/alertmanager:{{ alertmanager_version }}
    container_name: alertmanager
    restart: "{{ docker_container_restart_policy }}"
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager
    networks:
      - monitoring
    security_opt:
      - no-new-privileges:true

  node-exporter:
    image: quay.io/prometheus/node-exporter:{{ node_exporter_version }}
    container_name: node-exporter
    restart: "{{ docker_container_restart_policy }}"
    command:
      - --path.rootfs=/host
    pid: host
    uts: host
    volumes:
      - /:/host:ro,rslave
    networks:
      - monitoring
    security_opt:
      - no-new-privileges:true

  cadvisor:
    image: ghcr.io/google/cadvisor:{{ cadvisor_version }}
    container_name: cadvisor
    restart: "{{ docker_container_restart_policy }}"
    privileged: true
    devices:
      - /dev/kmsg:/dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    networks:
      - monitoring

volumes:
  prometheus_data:
  grafana_data:
  grafana_postgres_data:
  alertmanager_data:

networks:
  monitoring:
    driver: bridge

  edusmart_proxy:
    external: true
    name: edusmart_proxy
