---
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090
        labels:
          instance: srv-prd-par-dkr-001

  - job_name: docker-host
    static_configs:
      - targets:
          - node-exporter:9100
        labels:
          instance: srv-prd-par-dkr-001

  - job_name: cadvisor
    static_configs:
      - targets:
          - cadvisor:8080
        labels:
          instance: srv-prd-par-dkr-001

  - job_name: linux-servers
    static_configs:
{% set monitored_hosts = groups.get('linux_servers', []) + groups.get('ansible_controllers', []) %}
{% for hostname in monitored_hosts | unique | sort %}
{% if hostname not in groups.get('docker_hosts', []) %}
      - targets:
          - "{{ hostvars[hostname].ansible_host }}:9100"
        labels:
          instance: "{{ hostname }}"
          environment: production
{% endif %}
{% endfor %}
