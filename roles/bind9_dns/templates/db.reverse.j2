$ORIGIN {{ dns_reverse_zone }}.
$TTL 3600

@   IN SOA {{ dns_primary_hostname }}.{{ dns_domain }}. hostmaster.{{ dns_domain }}. (
        {{ dns_zone_serial }} ; serial
        3600                  ; refresh
        900                   ; retry
        1209600               ; expire
        300                   ; negative TTL
)

@   IN NS {{ dns_primary_hostname }}.{{ dns_domain }}.
@   IN NS {{ dns_secondary_hostname }}.{{ dns_domain }}.

{% for record in dns_reverse_records %}
{{ record.last_octet }}    IN PTR    {{ record.hostname }}.{{ dns_domain }}.
{% endfor %}
